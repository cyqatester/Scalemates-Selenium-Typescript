{
  "name": "scalemates-selenium-e2e",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "mocha --timeout 60000 --parallel --jobs 2 --require ts-node/register --require tsconfig-paths/register --require test/hooks.ts \"test/**/*.spec.ts\"",
    "test:chrome": "cross-env BROWSER=chrome npm test",
    "test:firefox": "cross-env BROWSER=firefox npm test",
    "test:single": "mocha --timeout 60000 --require ts-node/register --require tsconfig-paths/register --require test/hooks.ts"
  },
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/selenium-webdriver": "^4.35.7",
    "chai": "^5.3.3",
    "cross-env": "^10.1.0",
    "mocha": "^12.0.3",
    "selenium-webdriver": "^4.38.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "glob": "14.0.2",
    "minimatch": "11.0.1"
  }
}
